{
  "name": "jogos-da-mae",
  "version": "0.7.0",
  "private": true,
  "description": "Jogos simples e recordações para um familiar mais velho",
  "license": "CC0-1.0",
  "scripts": {
    "recursos": "python tools/preparar_recursos.py",
    "falas": "python tools/falas.py",
    "voz": "python tools/gerar_voz.py",
